---
import BaseLayout from '../layouts/BaseLayout.astro';

const features = [
  {
    title: 'JjTL: model-to-model transformations',
    description:
      'Declarative transformation language that maps source metamodel elements to target metamodel elements. Two-pass execution: the first pass creates instances, the second resolves attributes and cross-type references through an automatic trace model. Guards with the where keyword.',
  },
  {
    title: 'JjEL: expression language',
    description:
      'Unified expression language for queries, guards and computed values. Includes forall and exists, context binding, null-safe navigation, type checks and over 100 built-in methods. Available in the Console, in views and in transformations.',
  },
  {
    title: 'JjScript: metamodel manipulation',
    description:
      'Imperative language for programmatic metamodel editing: structural commands, bulk edits, forall, let and eval. Run sequences of operations on metamodels and models from the Console.',
  },
  {
    title: 'Data Manager',
    description:
      'Work with model data as tables, one per metaclass, with forms to create, edit and delete instances. Includes a containment outline, a one-hop neighborhood diagram on each row and a delete preview showing the cascade and the dangling references.',
  },
  {
    title: 'View Designer and forms',
    description:
      'Views are authored declaratively from property panels: Applies to, Structure, Symbol and Form. Instance nodes get headers, attribute compartments, accent bars and a library of value renderers (swatches, chips, reference pills, booleans). The same view renders as a form with four themes.',
  },
  {
    title: 'Jjodie: AI assistance',
    description:
      'An assistant integrated in the Console that generates metamodels and models through JjScript, explains views and drafts documentation. Bring your own provider: OpenAI, Anthropic, Gemini, Mistral, DeepSeek, Groq, Kimi or a local Ollama.',
  },
  {
    title: 'Redesigned UI',
    description:
      'Progressive disclosure throughout the interface, with Basic and Advanced modes in every panel. New Transformation Editor for defining and running JjTL transformations. Improved edge rendering with Manhattan routing.',
  },
  {
    title: 'Megamodel view',
    description:
      'A project-level diagram showing all metamodels, models, transformations and their relationships (conformsTo, inputOf, outputOf, generatedBy).',
  },
  {
    title: 'Console and saving',
    description:
      'Multi-language Console with three modes (Jjodie, JjScript, JjEL) and meta-commands. A single Save project action, with autosave after 15 seconds of inactivity and at most every two minutes.',
  },
];
---

<BaseLayout
  title="What's new in Jjodel 3.0 | Jjodel"
  description="New features in Jjodel 3.0: JjTL transformations, JjEL expressions, redesigned UI, and more."
>
  <div class="container">
    <section class="page-header">
      <h1>What's new in Jjodel 3.0</h1>
      <p class="page-header__subtitle">
        Jjodel 3.0 introduces three domain-specific languages, a redesigned
        interface, a new transformation engine and a Data Manager for working
        with model data. Released on 15 September 2026.
      </p>
      <div class="page-header__cta">
        <a href="https://app.jjodel.io" class="btn btn-primary" rel="noopener">
          Open Jjodel 3.0 →
        </a>
      </div>
    </section>

    <section class="section">
      <div class="features-grid">
        {
          features.map((f) => (
            <div class="card feature-card">
              <h3 class="feature-card__title">{f.title}</h3>
              <p class="feature-card__desc">{f.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2>Status</h2>
      <p class="status-text">
        Jjodel 3.0 is the current version at app.jjodel.io. The previous
        version (2.x) remains available at old.jjodel.io for a few months, so
        existing projects can be migrated at your own pace. Projects created
        during the beta open in 3.0.
      </p>
      <p class="status-text">
        Bug reports and feedback are welcome on{' '}
        <a
          href="https://github.com/jjodel-modeling/jjodel-frontend/issues"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>.
      </p>
    </section>

    <section class="section">
      <h2>Documentation</h2>
      <p class="status-text">
        Full documentation for the new languages and features is available on
        the docs site.
      </p>
      <div class="docs-links">
        <a
          href="https://docs.jjodel.io/whats-new/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Full changelog ↗
        </a>
        <a
          href="https://docs.jjodel.io/languages/jjel/"
          target="_blank"
          rel="noopener noreferrer"
        >
          JjEL Reference ↗
        </a>
        <a
          href="https://docs.jjodel.io/languages/jjtl/"
          target="_blank"
          rel="noopener noreferrer"
        >
          JjTL Reference ↗
        </a>
        <a
          href="https://docs.jjodel.io/languages/jjscript/"
          target="_blank"
          rel="noopener noreferrer"
        >
          JjScript Reference ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 2.5rem 0 1rem;
  }

  .page-header__subtitle {
    font-size: 1.06rem;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
    max-width: 600px;
  }

  .page-header__cta {
    margin-top: 1.5rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .feature-card__title {
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 8px;
  }

  .feature-card__desc {
    font-size: 0.882rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .status-text {
    font-size: 0.941rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    line-height: 1.7;
  }

  .docs-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 1rem;
  }

  .docs-links a {
    font-size: 0.882rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
