---
const dismissKey = 'release-banner-v2';
---

<div class="release-banner" id="release-banner" role="status">
  <div class="release-banner__inner">
    <p class="release-banner__text">
      <strong>Jjodel 3.0</strong> has arrived.
      <a href="https://app.jjodel.io" rel="noopener">Try it &rarr;</a>
    </p>
    <button class="release-banner__close" id="release-banner-close" type="button" aria-label="Dismiss">
      <i class="bi bi-x-lg" aria-hidden="true"></i>
    </button>
  </div>
</div>

<script define:vars={{ dismissKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('release-banner');
    const close = document.getElementById('release-banner-close');
    if (!banner || !close) return;
    let dismissed = false;
    try { dismissed = !!sessionStorage.getItem(dismissKey); } catch {}
    if (dismissed) { banner.remove(); return; }
    close.addEventListener('click', () => {
      try { sessionStorage.setItem(dismissKey, 'true'); } catch {}
      banner.remove();
    });
  });
</script>

<style>
  .release-banner {
    background: var(--jj-slate-900);
    color: var(--jj-white);
    padding: 8px 16px;
  }

  .release-banner__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .release-banner__text {
    margin: 0;
    font-size: 0.882rem;
    line-height: 1.5;
  }

  .release-banner__text strong {
    font-weight: 600;
  }

  .release-banner__text a {
    color: var(--jj-yellow);
    text-decoration: none;
    white-space: nowrap;
  }

  .release-banner__text a:hover {
    text-decoration: underline;
  }

  .release-banner__close {
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 4px;
    line-height: 1;
    color: var(--jj-slate-300);
    cursor: pointer;
  }

  .release-banner__close:hover {
    color: var(--jj-white);
  }

  @media (max-width: 768px) {
    .release-banner__inner {
      align-items: flex-start;
    }

    .release-banner__close {
      margin-top: 2px;
    }
  }
</style>
