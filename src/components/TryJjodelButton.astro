---
interface Props {
  label?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
}

const {
  label = 'Try Jjodel',
  variant = 'primary',
  size = 'md',
} = Astro.props;

const APP_URL = 'https://app.jjodel.io';
---

<div
  class:list={[
    'try-jjodel-button',
    `try-jjodel-button--${variant}`,
    `try-jjodel-button--${size}`,
  ]}
>
  <a
    class="try-jjodel-button__main"
    href={APP_URL}
    target="_blank"
    rel="noopener"
  >
    {label}
  </a>
</div>

<style>
  .try-jjodel-button {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    font-family: inherit;
  }

  .try-jjodel-button__main {
    display: inline-flex;
    align-items: center;
    font-family: inherit;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease;
  }

  .try-jjodel-button__main:hover {
    text-decoration: none;
    opacity: 0.9;
  }

  .try-jjodel-button__main:focus-visible {
    outline: 2px solid var(--jj-blue-600);
    outline-offset: 2px;
    z-index: 1;
  }

  .try-jjodel-button--primary .try-jjodel-button__main {
    background: var(--color-text);
    color: var(--jj-white);
    border-color: var(--color-text);
  }

  .try-jjodel-button--secondary .try-jjodel-button__main {
    background: var(--color-bg);
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .try-jjodel-button--secondary .try-jjodel-button__main:hover {
    background: var(--color-bg-secondary);
    opacity: 1;
  }

  .try-jjodel-button--sm .try-jjodel-button__main {
    padding: 9px 16px;
    font-size: 14px;
  }

  .try-jjodel-button--md .try-jjodel-button__main {
    padding: 12px 20px;
    font-size: 15px;
  }

  .try-jjodel-button--lg .try-jjodel-button__main {
    padding: 14px 26px;
    font-size: 16px;
  }
</style>
